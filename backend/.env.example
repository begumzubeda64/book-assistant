# Copy to .env for local development. Never commit a real .env.
# Secrets in AWS come from the task environment / Secrets Manager.

APP_ENV=local
LOG_LEVEL=INFO
AWS_REGION=eu-central-1

# Local emulation endpoints (leave unset when running against real AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_ENDPOINT_URL=http://localhost:4566

# Frontend origin(s) allowed by CORS (JSON array)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
