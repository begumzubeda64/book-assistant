# Copy to .env for local development. Never commit a real .env.
# Secrets in AWS come from the task environment / Secrets Manager.

APP_ENV=local
LOG_LEVEL=INFO
AWS_REGION=eu-central-1

# Local emulation endpoints (leave unset when running against real AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_ENDPOINT_URL=http://localhost:4566

# Frontend origin(s) allowed by CORS (JSON array)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Cognito authentication (unset locally until the user pool is provisioned).
# COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Local-only auth bypass for development. NEVER enable outside app_env=local.
AUTH_ALLOW_LOCAL_DEV_USER=false
LOCAL_DEV_USER_ID=local-dev-user

# Book discovery (optional)
# GOOGLE_BOOKS_API_KEY=
# BOOK_CACHE_TABLE_NAME=book-companion-dev-books

# Uploads and async jobs (from Terraform outputs; unset locally = degraded/no-op)
# UPLOADS_BUCKET_NAME=book-companion-dev-uploads
# JOBS_TABLE_NAME=book-companion-dev-jobs
# JOBS_QUEUE_URL=
VERIFY_UPLOADED_OBJECT=false

# Reading progress
# PROGRESS_TABLE_NAME=book-companion-dev-progress
