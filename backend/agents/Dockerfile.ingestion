# Ingestion agent image (LangGraph on Amazon Bedrock AgentCore Runtime).
#
# One of three ISOLATED agent images (decisions.md). Separate from the FastAPI
# image and the other agent images. Holds NO AWS data permissions beyond its own
# job-status bookkeeping; all content/KB access goes through the MCP tool server
# (authorized by the signed per-job scope token).
#
# Build context is backend/:  docker build -f agents/Dockerfile.ingestion .

FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra agents

COPY src ./src
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra agents

FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

RUN groupadd --system agent && useradd --system --gid agent --home /app agent

WORKDIR /app

COPY --from=builder --chown=agent:agent /app/.venv /app/.venv
COPY --chown=agent:agent src ./src

USER agent

# AgentCore Runtime invokes the BedrockAgentCoreApp entrypoint over HTTP (8080).
EXPOSE 8080

CMD ["python", "-m", "src.agents.ingestion.main"]
