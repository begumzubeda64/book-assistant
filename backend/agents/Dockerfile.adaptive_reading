# Adaptive-reading agent image (LangGraph on Amazon Bedrock AgentCore Runtime).
#
# One of three ISOLATED agent images (see decisions.md). Separate from the
# FastAPI image and the other agent images.
#
# Build context is backend/:  docker build -f agents/Dockerfile.adaptive_reading .
#
# Stub for milestone 1: the LangGraph graph and bedrock-agentcore entrypoint are
# implemented in task group 8.

FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd --system agent && useradd --system --gid agent --home /app agent

WORKDIR /app

COPY --chown=agent:agent src/agents/shared ./agents/shared
COPY --chown=agent:agent src/agents/adaptive_reading ./agents/adaptive_reading

USER agent

CMD ["python", "-c", "print('adaptive-reading agent placeholder - implemented in group 8')"]
