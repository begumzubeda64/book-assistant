# Book Companion agent image (LangGraph on Amazon Bedrock AgentCore Runtime).
#
# This is a SEPARATE container image from the FastAPI service (see tech/structure
# steering). It hosts the LangGraph agents (ingestion, adaptive-reading,
# discussion) that run off the request path, triggered via SQS.
#
# Stub for milestone 1: the agent entrypoint and LangGraph/bedrock-agentcore
# dependencies are added in task groups 7-9. The image builds now so CI/ECR
# wiring can be established early.

FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd --system agent && useradd --system --gid agent --home /app agent

WORKDIR /app

# TODO(agents): copy agent source and install LangGraph + bedrock-agentcore deps
# (a dedicated agent dependency group / pyproject is added with task group 7).
COPY --chown=agent:agent src/agents ./agents

USER agent

# AgentCore Runtime invokes the agent's server; placeholder until implemented.
CMD ["python", "-c", "print('agent image placeholder - implemented in groups 7-9')"]
